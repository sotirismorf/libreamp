<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.sotirismorf.LibreAmp</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>LibreAmp</name>
  <summary>Play music in classic Winamp skins</summary>
  <developer id="io.github.sotirismorf">
    <name>Sotiris Morfakidis</name>
  </developer>

  <description>
    <p>
      LibreAmp is a music player that looks and works like the classic Winamp 2: main window,
      equalizer and playlist, docked together and drawn with any classic .wsz skin.
    </p>
    <p>
      Skins are scaled by whole numbers with nearest-neighbour sampling, so they stay sharp on
      high-resolution screens instead of turning blurry.
    </p>
    <ul>
      <li>Classic .wsz skins, as archives or unpacked folders</li>
      <li>MP3, FLAC, Ogg Vorbis, M4A (AAC and ALAC) and WAV; M3U and PLS playlists</li>
      <li>10-band equalizer with the classic presets</li>
      <li>Spectrum analyzer and oscilloscope in the skin's colours</li>
      <li>Playlist text that can show Greek, Cyrillic and other non-Latin titles</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.sotirismorf.LibreAmp.desktop</launchable>
  <provides>
    <binary>libreamp</binary>
  </provides>

  <url type="homepage">https://github.com/sotirismorf/libreamp</url>
  <url type="bugtracker">https://github.com/sotirismorf/libreamp/issues</url>
  <url type="vcs-browser">https://github.com/sotirismorf/libreamp</url>

  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
    <category>Player</category>
  </categories>
  <keywords>
    <keyword>music</keyword>
    <keyword>player</keyword>
    <keyword>skin</keyword>
    <keyword>winamp</keyword>
  </keywords>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>

  <content_rating type="oars-1.1"/>

  <releases>
    <release version="0.1.0" date="2026-11-15">
      <description>
        <p>First public release.</p>
      </description>
    </release>
  </releases>
</component>
